<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{{ doc.title }}</title>
  <style>
    :root {
      --brand: {{ doc.theme.brand }};
      --brand-dark: {{ doc.theme.brand_dark }};
      --up: {{ doc.theme.up }};
      --down: {{ doc.theme.down }};
      --surface: {{ doc.theme.surface }};
      --muted: {{ doc.theme.muted }};
      --text: #1f2937;
      --border: #e5e7eb;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #f3f4f6;
      color: var(--text);
      font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      line-height: 1.45;
    }
    @page { size: A4 landscape; margin: 12mm; }
    .wrap { padding: 24px 16px 48px; }
    .report-page {
      width: 1600px;
      height: 900px;
      max-width: 100%;
      margin: 0 auto 28px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      page-break-after: always;
      break-after: page;
      position: relative;
      padding: 36px 48px 56px;
    }
    .cover {
      background: linear-gradient(145deg, var(--brand) 0%, var(--brand-dark) 55%, #7f1d1d 100%);
      color: #fff;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }
    .cover h1, .cover p, .cover .eyebrow { color: #fff; }
    .eyebrow { font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.9; margin-bottom: 12px; }
    h1 { font-size: 40px; margin: 0 0 12px; line-height: 1.2; }
    h2 { font-size: 28px; margin: 0 0 16px; color: var(--brand-dark); }
    .cover h2 { color: #fff; }
    p { margin: 0 0 10px; }
    .muted { color: var(--muted); font-size: 13px; }
    .toc-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin-top: 12px;
    }
    .toc-card, .insight-card, .action-card, .summary-card, .risk-card, .decision-card, .opportunity-card {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px 16px;
      background: #fff;
    }
    .toc-card { min-height: 72px; border-left: 4px solid var(--brand); }
    .insight-card.summary, .summary-card { border-top: 3px solid var(--brand); }
    .insight-card.opportunity, .opportunity-card { border-top: 3px solid #2563eb; }
    .insight-card.risk, .risk-card { border-top: 3px solid #b45309; }
    .insight-card.decision, .decision-card { border-top: 3px solid #0f766e; }
    .card-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin-top: 14px;
    }
    .card-grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .metric {
      display: inline-block;
      background: #fff7ed;
      color: var(--brand-dark);
      border-radius: 999px;
      padding: 2px 8px;
      font-size: 12px;
      margin: 2px 4px 2px 0;
    }
    .blocks { margin-top: 12px; display: grid; gap: 14px; }
    .evidence {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 14px;
      background: #fafafa;
    }
    table.sample {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      margin-top: 8px;
    }
    table.sample th {
      background: var(--brand);
      color: #fff;
      text-align: left;
      padding: 6px 8px;
    }
    table.sample td {
      border-bottom: 1px solid var(--border);
      padding: 6px 8px;
      vertical-align: top;
    }
    .tone-up { color: var(--up); font-weight: 600; }
    .tone-down { color: var(--down); font-weight: 600; }
    .css-chart { margin-top: 8px; }
    .chart-title { font-weight: 600; margin-bottom: 8px; }
    .chart-caption { color: var(--muted); font-size: 12px; margin-top: 6px; }
    .bar-row, .col-item { display: grid; gap: 6px; margin-bottom: 8px; }
    .bar-row { grid-template-columns: 120px 1fr 90px; align-items: center; }
    .bar-track, .col-track {
      background: #fee2e2;
      border-radius: 999px;
      overflow: hidden;
      height: 12px;
    }
    .bar-fill, .col-fill { background: var(--brand); height: 100%; }
    .col-list { display: flex; gap: 10px; align-items: flex-end; min-height: 160px; }
    .col-item { flex: 1; grid-template-rows: auto 120px auto; justify-items: center; }
    .col-track {
      width: 28px;
      height: 120px;
      border-radius: 8px;
      display: flex;
      align-items: flex-end;
    }
    .col-fill { width: 100%; border-radius: 8px 8px 0 0; }
    .trend-svg { width: 100%; max-height: 220px; }
    .svg-label { font-size: 10px; fill: var(--muted); }
    .page-footer {
      position: absolute;
      left: 48px;
      right: 48px;
      bottom: 18px;
      font-size: 11px;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
      gap: 12px;
    }
    .actions ol { margin: 8px 0 0 18px; padding: 0; }
    .actions li { margin-bottom: 8px; }
    .disclaimer {
      margin-top: 10px;
      padding: 8px 10px;
      background: #fff7ed;
      border-left: 3px solid var(--brand);
      font-size: 12px;
    }
    @media print {
      body { background: #fff; }
      .wrap { padding: 0; }
      .report-page {
        border: none;
        border-radius: 0;
        margin: 0;
        width: auto;
        height: auto;
        min-height: 180mm;
      }
    }
  </style>
</head>
<body>
<div class="wrap">
{% for page in doc.pages %}
  <section class="report-page {% if page.layout == 'cover' %}cover{% endif %} {% if page.layout == 'actions' %}actions{% endif %}">
    {% if page.layout == 'cover' %}
      <div class="eyebrow" contenteditable="true">CateMate Print Vertical Report</div>
      <h1 contenteditable="true">{{ page.so_what_title }}</h1>
      {% for para in page.body_paragraphs %}
      <p contenteditable="true">{{ para }}</p>
      {% endfor %}
      {% if doc.subtitle %}
      <p contenteditable="true">{{ doc.subtitle }}</p>
      {% endif %}
    {% elif page.layout == 'toc' %}
      <h2 contenteditable="true">{{ page.so_what_title }}</h2>
      <div class="toc-grid">
        {% for item in page.toc_items %}
        <div class="toc-card"><div contenteditable="true">{{ loop.index }}. {{ item }}</div></div>
        {% endfor %}
      </div>
    {% else %}
      <h2 contenteditable="true">{{ page.so_what_title }}</h2>
      {% for para in page.body_paragraphs %}
      <p contenteditable="true">{{ para }}</p>
      {% endfor %}
      {% if page.cards %}
      <div class="card-grid {% if page.cards|length >= 3 %}three{% endif %}">
        {% for card in page.cards %}
        <div class="insight-card {{ card.kind }}">
          <strong contenteditable="true">{{ card.headline }}</strong>
          {% if card.body %}<p contenteditable="true">{{ card.body }}</p>{% endif %}
          {% for metric in card.fuzzy_metrics %}
          <span class="metric" contenteditable="true">{{ metric.label }}: {{ metric.display }}</span>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if page.blocks %}
      <div class="blocks">
        {% for block in page.blocks %}
        <div class="evidence">
          <p contenteditable="true">{{ block.conclusion }}</p>
          {% if block.notes %}
          <ul>
            {% for note in block.notes %}
            <li contenteditable="true">{{ note }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          {% if block.chart %}
            {{ render_css_chart(block.chart) | safe }}
          {% endif %}
          {% if block.table %}
          <table class="sample">
            <thead>
              <tr>
                {% for h in block.table.headers %}
                <th contenteditable="true">{{ h }}</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for row in block.table.rows %}
              <tr>
                {% for cell in row %}
                <td class="{% if cell.tone %}tone-{{ cell.tone }}{% endif %}" contenteditable="true">{{ cell.text }}</td>
                {% endfor %}
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if page.layout == 'actions' and doc.next_actions %}
      <h3 contenteditable="true">Next Actions</h3>
      <ol>
        {% for action in doc.next_actions %}
        <li>
          <span contenteditable="true">{{ action.action }}</span>
          <span class="muted" contenteditable="true">（{{ action.owner_hint }} · {{ action.priority }}）</span>
        </li>
        {% endfor %}
      </ol>
      {% endif %}
      <div class="disclaimer" contenteditable="true">{{ doc.disclaimer }}</div>
    {% endif %}
    <div class="page-footer">
      <span contenteditable="true">{{ doc.case_id }} · fuzzy_applied={{ doc.fuzzy_applied }}</span>
      <span contenteditable="true">{{ loop.index }} / {{ doc.pages|length }}</span>
    </div>
  </section>
{% endfor %}

  <section class="report-page" style="height:auto;min-height:420px;">
    <h2 contenteditable="true">交付说明 | How to use</h2>
    <ul>
      {% for note in doc.delivery_notes %}
      <li contenteditable="true">{{ note }}</li>
      {% endfor %}
    </ul>
    <div class="disclaimer" contenteditable="true">{{ doc.disclaimer }}</div>
    <div class="page-footer">
      <span contenteditable="true">{{ doc.generated_at }}</span>
      <span contenteditable="true">Print Vertical Report</span>
    </div>
  </section>
</div>
</body>
</html>
